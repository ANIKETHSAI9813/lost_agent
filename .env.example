# Lost-Deal Autopsy Agent - environment variables
# Copy to `env` or `.env` and fill in your own values.
# Never commit the real file. Both `env` and `.env` are in .gitignore.

# --- Memory backend -------------------------------------------------------
# hindsight (default) or local (fallback only, shown with a red badge)
MEMORY_BACKEND=hindsight

# Hindsight Cloud - https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sales-team-shared

# --- LLM (optional - the demo must work without it) -----------------------
# Groq - https://console.groq.com/keys
GROQ_API_KEY=
# openai/gpt-oss-120b is a production model on Groq and supports
# strict JSON-schema structured outputs (console.groq.com/docs/structured-outputs).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com

# D35: a fresh demo retires any live_added deals left in shared memory at startup.
DEMO_CLEAN_START=1
